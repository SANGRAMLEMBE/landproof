# Meta Model API key (dev.meta.ai). Required for sam-3.1, muse-spark-1.3, muse-image-1.0.
MODEL_API_KEY=

# Optional override (default https://api.meta.ai/v1)
META_API_BASE=https://api.meta.ai/v1

# Muse Glimmer served by modal_apps/glimmer_server.py (vLLM, OpenAI-compatible).
# After `modal deploy modal_apps/glimmer_server.py`, paste the printed URL + "/v1".
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=muse-glimmer

# NEVER route footage of people to the "-contributor" tier (Meta may train on it).
LANDPROOF_SPARK_MODEL=muse-spark-1.3
